{
  "name": "sharkcode",
  "version": "1.2.5",
  "description": "Local First, open-source AI Coding Agent",
  "type": "module",
  "bin": {
    "sharkcode": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "dev": "bun --watch src/cli.ts",
    "build": "tsup",
    "test": "bun test",
    "test:release": "node scripts/release-smoke.mjs",
    "postinstall": "node -e \"try{require('child_process').execSync('node node_modules/playwright/cli.js install chromium --quiet',{stdio:'ignore'})}catch(e){}\"",
    "prepublishOnly": "npm run build && bun test && npm run test:release"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.52",
    "@inquirer/prompts": "^8.3.2",
    "ai": "^6.0.156",
    "chalk": "^5.6.2",
    "ink": "^7.0.0",
    "playwright": "^1.49.0",
    "react": "^19.2.5",
    "smol-toml": "^1.6.1",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syy-shark/sharkcode.git"
  },
  "homepage": "https://github.com/syy-shark/sharkcode",
  "bugs": {
    "url": "https://github.com/syy-shark/sharkcode/issues"
  }
}
