{
  "name": "sharkcode",
  "version": "0.6.0",
  "description": "Local First, open-source AI Coding Agent",
  "type": "module",
  "bin": {
    "sharkcode": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "dev": "bun --watch src/cli.ts",
    "build": "tsup",
    "test": "bun test",
    "prepublishOnly": "npm run build && bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.48",
    "@inquirer/prompts": "^8.3.2",
    "ai": "^6.0.141",
    "chalk": "^5.6.2",
    "smol-toml": "^1.6.1",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syy-shark/sharkcode.git"
  },
  "homepage": "https://github.com/syy-shark/sharkcode",
  "bugs": {
    "url": "https://github.com/syy-shark/sharkcode/issues"
  }
}
